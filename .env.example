# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key. Safe for the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Postgres connection for one-off operational scripts such as
# `npm run seed:production`. Prefer Supabase's pooled connection string.
SUPABASE_DB_URL=
# Or use PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD instead.
PGHOST=
PGPORT=6543
PGDATABASE=postgres
PGUSER=
PGPASSWORD=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudinary (server only, except the cloud name which the browser needs
# to build delivery URLs)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Unsigned/signed upload preset name if you use one.
CLOUDINARY_UPLOAD_FOLDER=tngdaily
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---------------------------------------------------------------------------
# Stock photo providers (server only, proxied through /api/images/search)
# ---------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---------------------------------------------------------------------------
# AI secret storage
# ---------------------------------------------------------------------------
# production   -> Supabase Vault (requires the supabase_vault extension)
# development  -> encrypted local file adapter (never used in production)
SECRET_STORE_DRIVER=development
# 32-byte key, base64 encoded. Required by the development adapter.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_STORE_DEV_KEY=

# Optional development fallback only. Do not use user-owned provider keys here in production.
AI_LOCAL_DEV_FALLBACK_KEY=
AI_LOCAL_DEV_FALLBACK_BASE_URL=
AI_LOCAL_DEV_FALLBACK_MODEL=

# ---------------------------------------------------------------------------
# Local development conveniences
# ---------------------------------------------------------------------------
# When Supabase is not configured, the public site renders bundled demo
# articles so the design can be reviewed. Never enabled in production.
# Set to "false" to see the real empty/setup states instead.
DEMO_CONTENT=true
